# ============================================================
# server-backup.sh 配置文件示例
#
# 使用方法:
#   1. cp backup.env.example backup.env
#   2. 填入下方占位符的真实值
#   3. chmod 600 backup.env   (含 TOKEN, 必须收紧权限)
#
# 部署位置: 和 server-backup.sh 同目录
#   例如 /server-backup/{server-backup.sh, backup.env}
# ============================================================

# ---------- Telegram (必填) ----------
# 在 @BotFather 创建 bot 后获得的 HTTP API token
TOKEN="<your-telegram-bot-token>"

# 群组/频道 ID (负数代表群组, 正数代表用户)
# 获取方法: 拉 @userinfobot 进群, 或 curl 一次 getUpdates
CHAT_ID="<your-chat-id>"

# 话题群的 Thread ID; 普通群聊留空字符串 ""
THREAD_ID=""

# 本地 Bot API 反代地址 (绕过 50MB 文件上限)
# 自部署 aiogram/telegram-bot-api 容器时常用 55522/8081
TG_API="http://127.0.0.1:55522"

# ---------- 备份基本信息 ----------
# 用于生成文件名 backup_${BACKUP_NAME}_${DATE}.tar.gz 和 TG caption
BACKUP_NAME="my-server"

# ---------- 备份目录 (必填, bash 数组) ----------
# 一般服务器推荐这几个; 按你的环境增删
SOURCE_DIRS=(
    /etc                        # 系统配置
    /root                       # root 家目录 (脚本/SSH 密钥)
    /opt                        # 应用 + DB dump
    /var/lib/docker/volumes     # Docker 持久化数据
)

# 排除路径 (HOST_STAGING_DIR 会自动加入)
EXCLUDES=(
    # /opt/some_huge_log
    # /var/lib/docker/volumes/cache_xxx
)

# ---------- 暂存路径 ----------
# 压缩分卷的中转目录, 上传成功后会自动清理
HOST_STAGING_DIR="/backup"
# Bot API 容器内看到的暂存目录路径 (Bot 不在容器中时保持一致)
DOCKER_READ_PATH="/backup"

# ---------- 分卷 / 重试 ----------
# 单个分卷大小, Bot API 反代后单文件上限 ~2GB, 留余量
SPLIT_SIZE="1900M"

# 上传失败时最多重试次数 (含首次)
MAX_RETRY="3"

# ---------- PostgreSQL Dump (可选) ----------
# 设为 true 时, 会先 docker exec pg_dumpall 输出到 PG_DUMP_PATH 再打包
# 没跑 PG 容器就保持 false
PG_DUMP_ENABLED="false"

# 容器名: 用 `docker ps --format '{{.Names}}'` 查看
PG_CONTAINER="postgres"

# 数据库超级用户名 - 留空则自动用容器内的 $POSTGRES_USER (推荐)
# 密码始终从容器内的 $POSTGRES_PASSWORD 读取, 无需在此配置
PG_USER=""

# Dump 输出路径 (必须在 SOURCE_DIRS 之一的子目录里, 才会被打包)
PG_DUMP_PATH="/opt/db_dump"

# 本地保留多少天的 dump (TG 端按消息历史保留, 这里是落地副本)
PG_DUMP_KEEP_DAYS="7"
